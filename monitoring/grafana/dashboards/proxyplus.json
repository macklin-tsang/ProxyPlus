{
  "uid": "proxyplus",
  "title": "ProxyPlus",
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{job}}", "expr": "sum by (job) (rate(proxyplus_requests_total[$__rate_interval]))"}]
    },
    {
      "id": 2, "type": "stat", "title": "Cache hit ratio",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "targets": [{"refId": "A", "expr": "sum(rate(proxyplus_cache_hits_total[$__rate_interval])) / (sum(rate(proxyplus_cache_hits_total[$__rate_interval])) + sum(rate(proxyplus_cache_misses_total[$__rate_interval])))"}]
    },
    {
      "id": 3, "type": "stat", "title": "Active connections",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "none", "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "targets": [{"refId": "A", "expr": "sum(proxyplus_active_connections)"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Upstream latency",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(proxyplus_upstream_latency_seconds_bucket[$__rate_interval])))"},
        {"refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(proxyplus_upstream_latency_seconds_bucket[$__rate_interval])))"},
        {"refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(proxyplus_upstream_latency_seconds_bucket[$__rate_interval])))"}
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Bytes transferred",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "sent to clients ({{job}})", "expr": "sum by (job) (rate(proxyplus_bytes_sent_total[$__rate_interval]))"},
        {"refId": "B", "legendFormat": "read from origins", "expr": "sum(rate(proxyplus_upstream_bytes_total[$__rate_interval]))"}
      ]
    }
  ]
}
